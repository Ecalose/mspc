            "url": "https://gh-proxy.com/https://github.com/bggRGjQaUbCoE/PiliPlus/releases/download/2.1.0/PiliPlus_windows_2.1.0+5109_x64_portable.zip",
            "hash": "2a224047f55e1431910d527efe63a23828c701b8622e8c314d4e2102aa13349d"
        }
    },
    "extract_dir": "PiliPlus-Win",
    "extract_to": "app",
    "shortcuts": [
        [
            "app\\piliplus.exe",
            "PiliPlus"
        ]
    ],
    "pre_install": [
        "$target = \"$persist_dir\\appdata\"",
        "if (!(Test-Path $target)) { New-Item -ItemType Directory -Path $target -Force | Out-Null }",
        "$link = \"$env:AppData\\com.example\\piliplus\"",
        "if (Test-Path $link) { if ((Get-Item $link).LinkType -ne 'Junction') { Move-Item $link $target -Force } }",
        "else { New-Item -ItemType Directory -Path (Split-Path $link) -Force | Out-Null }",
        "if (!(Test-Path $link)) { cmd /c mklink /J \"$link\" \"$target\" | Out-Null }"
    ],
    "pre_uninstall": [
        "Get-Process piliplus -ErrorAction SilentlyContinue | Stop-Process -Force",
        "$link = \"$env:AppData\\com.example\\piliplus\"",
        "if ($purge -and (Get-Item $link -ErrorAction SilentlyContinue).LinkType -eq 'Junction') { Remove-Item $link -Force }",
        "if ($purge) { Remove-Item \"$env:LocalAppData\\com.example\\piliplus\" -Recurse -Force -ErrorAction SilentlyContinue }"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/bggRGjQaUbCoE/PiliPlus/releases/latest",
        "regex": "/download/([^/]+)/PiliPlus_windows_(?<main>[\\d.]+)%2B(?<build>\\d+)_x64_portable.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gh-proxy.com/https://github.com/bggRGjQaUbCoE/PiliPlus/releases/download/$version/PiliPlus_windows_$matchMain+$matchBuild_x64_portable.zip"
            }
        }
    }
}
